<?xml version="1.0" ?>

<simulation>

  <context id="test">

    <variable_definition>
      <variable id="output_field_model_number" type="int">2</variable>
    </variable_definition>


    <field_definition level="1" enabled=".TRUE.">
      <field id="input_field_model"  read_access="true" operation="instant" freq_offset="0ts" grid_ref="model_grid3D"/>


      <field id="output_field_model_0" field_ref="input_field_model" comment="no operation">
        input_field_model
      </field>

      <field id="output_field_model_1" field_ref="input_field_model" comment=" + 1">
        input_field_model + 1
      </field>

    </field_definition>

    <file_definition type="one_file" output_freq="1ts" sync_freq="1ts">

      
      <file id="output_file" name="output" mode="write" pool_writer="pool" writer="writer" output_freq="1ts" type="one_file" >
        <field id="output_field_file_0" field_ref="input_field_model" freq_offset="0ts" comment="no operation">
          input_field_model
        </field>

        <field id="output_field_file_1" field_ref="input_field_model" freq_offset="0ts" comment=" + 1">
          input_field_model + 1
        </field>

      </file>

    </file_definition>

    <domain_definition>
      <domain id="domain" type="rectilinear"/>
    </domain_definition>

    <axis_definition>
      <axis id="axis" />
    </axis_definition>


    <grid_definition>
  
      <grid id="model_grid3D">
        <domain domain_ref="domain"/>
        <axis axis_ref="axis"/>
      </grid>

  </grid_definition>


  </context>

  <context id="xios">

    <pool_definition>
      <pool name="pool" global_fraction="1.0">
          <service name="writer"  global_fraction="1.0" type="writer"  />
      </pool> 
    </pool_definition> 


     <variable_definition>
        <variable_group id="parameters" >
          <variable id="using_server" type="bool">true</variable>
          <variable id="print_file" type="bool">true</variable>
          <variable id="log_type" type="string">log_profile</variable>
          <variable id="using_server" type="bool">false</variable>
          <variable id="check_event_sync" type="bool">true</variable>
          <variable id="transport_protocol" type="string">p2p</variable>
          <variable id="services_use_window_manager" type="bool">false</variable>
          <variable id="info_level" type="int">100</variable>
        </variable_group>
     </variable_definition>
  </context>

</simulation>
