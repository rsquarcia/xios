#!/bin/bash
# make_xios — XIOS build driver script

# ─── Defaults ────────────────────────────────────────────────────────────────
build_dir=$PWD
compil_full="false"
use_oasis="false"
oasis="oasis3_mct"
build_path="./"
build_dir_name=""
install_dir=""
build_suffixed="false"
use_extern_blitz="false"
use_memtrack="false"
use_python="false"
job="1"
netcdf_lib="netcdf4_par"
compil_mode="prod"
lib_mode="static"
arch_path=$PWD/"arch"
arch_default_path=$PWD/"arch"
arch_defined="FALSE"
arch_path_defined="FALSE"
fcm_version="new"
dry_run="false"
backend="fcm"
verbose=""

# ─── Functions ───────────────────────────────────────────────────────────────
print_cmd() {
    printf '  '
    printf '%q ' "$@"
    printf '\n'
}

print_if_else() {
    if [[ "$1" == "true" ]]; then
        printf '%s' "$2"
    else
        printf '%s' "$3"
    fi
}

print_help() {
  cat <<'EOF'
make_xios - Configure and build XIOS on your architecture

Usage:
  ./make_xios --arch <name> [options]

Options:
  -h, --help                        Show this help
  --prod                            Compilation mode: production (default)
  --dev                             Compilation mode: development
  --debug                           Compilation mode: debug
  --static                          Build static library (default)
  --dynamic                         Build shared library
  --arch <name>                     Target architecture name (required)
  --arch_path <path>                Additional architecture root path to search first
  --avail                           List available architectures and exit
  --full                            Remove build directory before building (clean build)
  --build_path <path>               Root path for build directory (default: repo root)
  --build_dir <name|path>           Build directory name (default: none for FCM, 'build' for CMake)
  --install_dir <path>              Installation directory (default: repo root)
  --build_suffixed                  Use config_<arch>_<mode> build directory naming
  --job <n>                         Parallel build jobs (default: 1)
  --netcdf_lib <mode>               netcdf4_par (default) | netcdf4_seq | netcdf4_internal
  --use_oasis <mode>                oasis3 | oasis3_mct_old | oasis3_mct (default)
  --use_extern_blitz                Use external blitz library
  --use_python                      Enable Python bindings
  --memtrack <light|full>           Track memory leaks (developer only)
  --doc                             Generate Doxygen documentation (not available yet)
  --fcm <new|old>                   FCM version compatibility
  --cmake                           Use CMake build system instead of FCM
  --dry-run                         Resolve and print configuration without building
  --verbose                         Print verbose output during build

Examples:
  ./make_xios --arch X64_IRENE --prod --job 8
  ./make_xios --arch X64_IRENE_GNU --debug --dry-run
EOF
}

print_avail() {
    for f in arch/arch-*.fcm; do
        basename "${f}" .fcm | sed 's/arch-//'
    done
}


# ─── CLI ─────────────────────────────────────────────────────────────────────
while (($# > 0)); do
    case $1 in
        "-h"|"--help"|"-help") print_help ; exit 0  ;;
        "--prod")              compil_mode="prod"   ; shift ;;
        "--dev")               compil_mode="dev"    ; shift ;;
        "--debug")             compil_mode="debug"  ; shift ;;
        "--static")            lib_mode="static"  ; shift ;;
        "--dynamic")           lib_mode="dynamic" ; shift ;;
        "--arch")              arch=$2 ; arch_defined="TRUE"; shift ; shift ;;
        "--arch_path")         arch_path=$2 ; arch_path_defined="TRUE"; shift ; shift ;;
        "--avail")             print_avail ; exit 0 ;; 
        "--full")              compil_full="true"   ; shift ;;
        "--use_oasis")         use_oasis="true" oasis=$2 ; shift ; shift  ;;
        "--build_path")        build_path=$2        ; shift ; shift ;;
        "--build_dir")         build_dir_name=$2         ; shift ; shift ;;
        "--install_dir")       install_dir=$2         ; shift ; shift ;;
        "--build_suffixed")    build_suffixed="true" ; shift  ;;
        "--use_extern_blitz")  use_extern_blitz="true" ; shift  ;;
        "--use_python")        use_python="true" ; shift  ;;
        "--doc")               doc="true"           ; shift ;;
        "--job")               job=$2               ; shift ; shift ;;
        "--netcdf_lib")        netcdf_lib=$2        ; shift ; shift ;;
        "--memtrack")          use_memtrack="true" memtrack=$2  ; shift ; shift ;;
        "--fcm")               fcm_version=$2  ; backend="fcm" ; shift ; shift ;;
        "--cmake")             backend="cmake" ; shift ;;
        "--dry-run")           dry_run="true" ; shift ;;
        "--verbose")           verbose="true" ; shift ;;
        *)                     code="$1"            ; shift ;;
    esac
done

# ─── Resolve build directories ───────────────────────────────────────────────

if [[ "${build_dir_name}" == "" && "${backend}" == "cmake" ]]; then
    # For CMake, default to "build" if no build directory is specified, to avoid
    # cluttering the source tree.
    build_dir_name="build"
    if [[ "${install_dir}" == "" ]]; then
        install_dir="./"
    fi
elif [[ "${build_dir_name}" != "" && "${install_dir}" == "" ]]; then
    install_dir="${build_path%/}/${build_dir_name}"
fi

# ─── Find architecture files ─────────────────────────────────────────────────

if [[ "${arch_defined}" != "TRUE" ]]; then
    echo "Please choose a target architecture from the list (make_xios --avail):"
    print_avail
    exit 1
fi


_find_arch_file() {
    local suffix="$1"
    if   [[ -f "${arch_path}/arch-${arch}.${suffix}" ]]; then
        echo "${arch_path}/arch-${arch}.${suffix}"
    elif [[ -f "${arch_default_path}/arch-${arch}.${suffix}" ]]; then
        echo "${arch_default_path}/arch-${arch}.${suffix}"
    else
        echo "Error: arch-${arch}.${suffix} not found in ${arch_path} or ${arch_default_path}" >&2
        exit 1
    fi
}

arch_env_file="$(_find_arch_file env)" || exit 1
arch_fcm_file="$(_find_arch_file fcm)" || exit 1
arch_path_file="$(_find_arch_file path)" || exit 1

source "${arch_env_file}"
if [[ "$backend" == "fcm" ]]; then
    source "${arch_path_file}"
elif [[ "$backend" == "cmake" ]]; then
    eval "$(python3 cmake/import_arch_path.py "${arch_path_file}")"
fi

# ─── Python keys ────────────────────────────────────────────────────────

if [[ "$use_python" == "true" ]]; then
    XIOS_CPPKEY="$XIOS_CPPKEY USE_PYTHON"
fi

# ─── Memtrack mode ───────────────────────────────────────────────────────────

if [[ "$use_memtrack" == "true" ]]; then
    XIOS_CPPKEY="$XIOS_CPPKEY XIOS_MEMTRACK"

    if [[ "$memtrack" == "light" ]]; then
	    XIOS_CPPKEY="$XIOS_CPPKEY XIOS_MEMTRACK_LIGHT"
    elif [[ "$memtrack" == "full"  ]]; then
        XIOS_CPPKEY="$XIOS_CPPKEY XIOS_MEMTRACK_FULL"
    else
	    echo "Bad choice for --memtrack argument : choose between 'light' or 'full'"
	    exit
    fi
fi


# ─── Parallel compression ────────────────────────────────────────────────────

# Detecting if parallel compression is available :
#   - NetCDF is HDF5 based and >= 4.7.4  ?
#   - HDF5   is parallel   and >= 1.10.3 ?
USE_HDF5=0
if [[ ! -z $NETCDF_INCDIR ]]
then
    NETCDF_LOOKUP=`echo ${NETCDF_INCDIR} | sed 's/\-I/\ /g'`
    netcdf_meta_file=`find $NETCDF_LOOKUP -name netcdf_meta.h 2> /dev/null`
else
    for dir in `echo $CPATH | sed 's/\:/\ /g'` ; do
        if [ -f "$dir/netcdf_meta.h" ]
        then
            netcdf_meta_file=$dir/netcdf_meta.h
            break
        fi
    done
fi
if [[ ! -z $netcdf_meta_file ]]
then
    NC_MAJOR=`grep "define NC_VERSION_MAJOR" $netcdf_meta_file | awk '{ print $3 }'`
    NC_MINOR=`grep "define NC_VERSION_MINOR" $netcdf_meta_file | awk '{ print $3 }'`
    NC_PATCH=`grep "define NC_VERSION_PATCH" $netcdf_meta_file | awk '{ print $3 }'`
    if ( [[ "$NC_MAJOR" -ge 5 || ( "$NC_MAJOR" -eq 4 &&  "$NC_MINOR" -ge 8 )|| ( "$NC_MAJOR" -eq 4 && "$NC_MINOR" -eq 7 && "$NC_PATCH" -ge 4 ) ]] )
    then
        USE_HDF5=`grep NC_HAS_HDF5 $netcdf_meta_file | awk '{ print $3 }'`
    fi
fi

if [ "$USE_HDF5" == "1" ]
then
    # https://forum.hdfgroup.org/t/parallel-compression-support-detection/5398    
    if [[ ! -z $HDF5_LIBDIR ]]
    then
        HDF5_LOOKUP=`echo ${HDF5_LIBDIR} | sed 's/\-L/\ /g'`
        hdf5_settings_file=`find $HDF5_LOOKUP -name libhdf5.settings 2> /dev/null`
    else
        for dir in `echo $LD_LIBRARY_PATH | sed 's/\:/\ /g'` ; do
            if [ -f "$dir/libhdf5.settings" ]
            then
                hdf5_settings_file=$dir/libhdf5.settings
                break
            fi
        done
    fi
    if [[ ! -z $hdf5_settings_file ]]
    then
        HDF5_VERSION=`grep "HDF5 Version" $hdf5_settings_file | awk -F  ':' '{ print $2 }'`
        HDF5_MAJOR_VERSION=`echo $HDF5_VERSION | awk -F  '.' '{ print $2 }'`
        HDF5_MINOR_VERSION=`echo $HDF5_VERSION | awk -F  '.' '{ print $3 }'`
        HDF5_PARALLEL=`grep "Parallel HDF5" $hdf5_settings_file | grep -ci -e on -e yes`
        HDF5_DEFLATE=`grep "I/O filters (external)" $hdf5_settings_file | grep -ci deflate`
        if ( [[ "$HDF5_MAJOR_VERSION" -ge 11 || ( "$HDF5_MAJOR_VERSION" -eq 10 &&  "$HDF5_MINOR_VERSION" -ge 3 ) ]] )
        then
            if [[ "$HDF5_PARALLEL" == "1" && "$HDF5_DEFLATE" == "1" ]]
            then 
                XIOS_CPPKEY="$XIOS_CPPKEY PARALLEL_COMPRESSION"
            fi
        fi          
    fi # hdf5_settings_file 
fi

if [[ "$XIOS_CPPKEY" =~ "PARALLEL_COMPRESSION" ]]
then
    echo "->Parallel compression is available"
else
    echo "->Parallel compression is NOT available"    
fi

# ─── NetCDF keys ────────────────────────────────────────────────────────

if [[ "$netcdf_lib" == "netcdf4_par" ]]; then
    XIOS_CPPKEY="$XIOS_CPPKEY USING_NETCDF_PAR"
elif [[ "$netcdf_lib" == "netcdf4_internal" ]]; then
    XIOS_CPPKEY="$XIOS_CPPKEY USING_NETCDF_PAR USING_NETCDF_INTERNAL"
else
   echo "Bad choice for --netcdf_lib argument : choose between 'netcdf4_par', 'netcdf4_seq' or 'netcdf4_internal'"
   exit
fi

# ─── OASIS keys ────────────────────────────────────────────────────────

if [[ "$use_oasis" == "true" ]]; then
    if [[ "$oasis" == "oasis3_mct" ]]; then
	    XIOS_CPPKEY="$XIOS_CPPKEY USE_OMCT"
    elif [[ "$oasis" == "oasis3_mct_old" ]]
    then
        XIOS_CPPKEY="$XIOS_CPPKEY USE_OMCT_OLD"
    elif [[ "$oasis" == "oasis3"  ]]; then
	    XIOS_CPPKEY="$XIOS_CPPKEY USE_OASIS"
    else
        echo "Bad choice for --use_oasis argument : choose between 'oasis3', 'oasis3_mct_old', 'oasis3_mct'"
        exit
    fi
fi

# ── Print resolved configuration ─────────────────────────────────────────────

echo ""
echo "-- XIOS configuration:"
echo "--   Architecture   : ${arch}"
echo "--   Build mode     : ${compil_mode}"
echo "--   Library mode   : ${lib_mode}"
echo "--   NetCDF mode    : ${netcdf_lib}"
echo "--   OASIS          : $(print_if_else "$use_oasis" "$oasis" "disabled")"
echo "--   Memtrack       : $(print_if_else "$use_memtrack" "$memtrack" "disabled")"
echo "--   XIOS_CPPKEY    : $(echo $XIOS_CPPKEY | xargs | tr ' ' ';')"
echo "--   Build dir      : $(print_if_else "$build_suffixed" "config_${arch}_${compil_mode}" ${build_path%/}/${build_dir_name})"
echo "--   Install dir    : ${install_dir}"
echo "--   Clean build    : $(print_if_else "$compil_full" "yes" "no")"
echo ""

if [[ "$dry_run" == "true" ]]; then
    source make_xios_${backend}
    exit 0
fi

# ─── Decompress archives ─────────────────────────────────────────────────────

nb_files_gz=`ls $PWD/tools/archive | grep tar.gz | wc -l`
if [ ${nb_files_gz} -ne 0 ]; then
    echo -e "- Decompressing archives..."		
    for tarname in `ls $PWD/tools/archive/*.tar.gz` ; do
        if  ( [[ ${tarname} == "$PWD/tools/archive/blitz.tar.gz" ]] && [[ "$use_extern_blitz" == "true" ]] ); then
            continue
        fi
        gunzip -f "$tarname"
        tar -xf ${tarname%.gz}
    done
fi

# ─── Build root directory ────────────────────────────────────────────────────

if [[ "$build_path" == "./" ]]; then
  build_dir=$PWD
else
  build_dir=${build_path}
fi

if [[ "$build_suffixed" == "true" ]]; then
    build_dir="${build_dir}/config_${arch}_${compil_mode}"
else
    build_dir="${build_dir}/${build_dir_name}"
fi

mkdir -p $build_dir

# ─── Backend build script ────────────────────────────────────────────────────
source make_xios_${backend}
